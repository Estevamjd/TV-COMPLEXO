# Banco de dados PostgreSQL (Neon.tech ou outro)
DATABASE_URL="postgresql://usuario:senha@host:5432/nomedb?sslmode=require"

# JWT — use uma chave aleatória de 64+ caracteres (ex: openssl rand -base64 64)
JWT_SECRET="gere_uma_chave_aleatoria_forte_com_64_caracteres_ou_mais"

# Admin — credenciais do painel administrativo
ADMIN_EMAIL="admin@tvcomplexo.com.br"
ADMIN_USER="admin"
# Hash PBKDF2 (Vercel e Cloudflare): node scripts/gerar-hash-pbkdf2.js  (a senha vem pela entrada padrão)
# Formato: pbkdf2$<iterações>$<sal>$<hash>. Hashes bcrypt antigos ($2a$...) ainda são aceitos, mas
# passam do limite de CPU do Workers grátis. Num .env local, escape cada $ como \$.
ADMIN_PASSWORD_HASH="pbkdf2$..."

# Endereço público (canonical, sitemap, OG). Vazio = https://tv-complexo.vercel.app. Lida no build.
NEXT_PUBLIC_SITE_URL=""

# Ambiente do deploy: "preview" só na prévia. Se vazia, vale VERCEL_ENV (a Vercel define sozinha).
APP_ENV=""

# Vercel Blob Storage (uploads de thumbnails na Vercel)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Cloudflare R2 (uploads no Worker; binding UPLOADS no wrangler.jsonc). URL pública do bucket,
# sem barra final. Lida também no build, para entrar no CSP.
R2_PUBLIC_URL=""

# YouTube Automation (Vercel Cron) e live na Início
YOUTUBE_CHANNEL_ID="UCxxxxxxxxxxxxxxxxxxxxxxxxx"
# Live automática (só servidor; nunca use NEXT_PUBLIC_). OPCIONAL: com chave, a detecção usa a
# API (tem precedência); sem chave, usa a página /live do canal.
YOUTUBE_API_KEY=""
# "0" desliga a detecção da live (com ou sem chave). Vazio = ligada.
LIVE_YOUTUBE_AUTO=""
# SÓ PRÉVIA/TESTE: ID de um vídeo ao vivo para simular a live. Só vale com APP_ENV=preview (ou, sem APP_ENV, VERCEL_ENV=preview); ignorada em production, development e sem as duas.
LIVE_MOCK_VIDEO_ID=""
CRON_SECRET="chave_secreta_para_proteger_o_cron"

# Webhook Secret (para integração com n8n)
WEBHOOK_SECRET="chave_secreta_para_webhooks"
