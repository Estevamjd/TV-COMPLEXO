# =============================================================================
# TV-COMPLEXO — Variáveis de ambiente
# Gere segredos aleatórios com: openssl rand -hex 32
# =============================================================================

# Banco de dados PostgreSQL (Neon.tech ou outro)
DATABASE_URL="postgresql://usuario:senha@host:5432/nomedb?sslmode=require"

# JWT — chave aleatória de 64+ caracteres. Gere com: openssl rand -base64 64
JWT_SECRET="GERE_UMA_CHAVE_ALEATORIA_FORTE_COM_64_CARACTERES_OU_MAIS"

# Admin — credenciais do painel administrativo
ADMIN_EMAIL="admin@example.com"
ADMIN_USER="admin"
# OBRIGATÓRIO. Gere com: node scripts/generate-password-hash.js "sua_senha_forte"
ADMIN_PASSWORD_HASH="$2a$12$EXEMPLO_SUBSTITUA_PELO_HASH_REAL"

# Vercel Blob Storage (para uploads de thumbnails)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# YouTube Automation (Vercel Cron)
YOUTUBE_CHANNEL_ID="UCxxxxxxxxxxxxxxxxxxxxxxxxx"
# Gere com: openssl rand -hex 32
CRON_SECRET="SUBSTITUA_POR_HEX_32_BYTES_ALEATORIOS"

# Webhook Secret (para integração com n8n e outros)
# Gere com: openssl rand -hex 32
WEBHOOK_SECRET="SUBSTITUA_POR_HEX_32_BYTES_ALEATORIOS"

# =============================================================================
# Domínio
# =============================================================================
# URL base canônica do site (usada em OG, sitemap, robots.txt)
NEXT_PUBLIC_SITE_URL="https://seu-dominio.com.br"

# (Opcional) Domínio antigo — se definido, requisições para ele são redirecionadas
# via 301 para NEXT_PUBLIC_SITE_URL. Apenas o hostname, sem protocolo.
# Exemplo: LEGACY_DOMAIN="dominio-antigo.com.br"
LEGACY_DOMAIN=""

# =============================================================================
# Rate limiting distribuído (opcional, mas altamente recomendado em produção)
# =============================================================================
# Se definidos, o rate limiter usa Upstash Redis (consistente entre instâncias
# serverless). Sem eles, cai para in-memory (best-effort por instância).
# Crie grátis em: https://console.upstash.com/redis ou via Vercel Marketplace
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# =============================================================================
# Ambiente
# =============================================================================
NODE_ENV="development"
