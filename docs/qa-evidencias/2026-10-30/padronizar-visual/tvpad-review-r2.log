    --f-heading: var(--font-archivo-black), 'Arial Black', sans-serif;
    --f-body: var(--font-inter-tight), system-ui, sans-serif;
    --f-mono: var(--font-space-mono), ui-monospace, monospace;
    --gutter: 16px; --content-max: 1296px;
    --border: 3px solid var(--ink);

    background: var(--paper);
    color: var(--ink);
    font-family: var(--f-body);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
    overflow-x: clip;
}
@media (min-width: 1024px) { .root { --gutter: 72px; } }

/* a home usa cabeçalho e rodapé próprios: tira o recuo do header fixo e o fundo escuro global */
:global(main):has(> .root) { padding: 0; }
:global(body):has(.root) { background: #FAF7F0; }

.root a { color: inherit; }
.root :focus-visible { outline: 4px solid var(--ink); outline-offset: 3px; }
/* foco: tinta sobre papel/amarelo/rosa (>= 5,6:1); amarelo sobre tinta/azul/vermelho (seções escuras abaixo) */
/* :where = especificidade zero, para não passar por cima de .fileiraLista, .noticiasLista, .diaProgs */
:where(.root ul, .root ol) { list-style: none; margin: 0; padding: 0; }
