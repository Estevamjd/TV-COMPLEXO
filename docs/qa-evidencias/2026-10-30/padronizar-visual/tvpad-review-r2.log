+        <nav aria-label="Principal" className={className}>
+            <ul>
+                {NAV_ITENS.filter(item => !item.cta).map(item => (
+                    <li key={item.href}>
+                        <Link href={item.href} aria-current={item.href === ativo ? 'page' : undefined}>{item.label}</Link>
+                    </li>
+                ))}
+            </ul>
+        </nav>
+    );
