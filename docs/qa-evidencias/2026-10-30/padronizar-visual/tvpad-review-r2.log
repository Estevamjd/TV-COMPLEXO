'use client';
import { suavizarPlaceholders } from '@/lib/exibicao';
import { useEffect, useRef, useState } from 'react';

const tipoColors = {
    falta_de_luz: '#f4a261',
    lixo_acumulado: '#e76f51',
    risco_deslizamento: '#e63946',
