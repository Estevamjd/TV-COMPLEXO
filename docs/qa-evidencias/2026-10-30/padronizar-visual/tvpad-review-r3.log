    border-color: var(--color-red);
}
@media (prefers-reduced-motion: reduce) {
    .admin-tema .card,
    .admin-tema .card:hover {
        transition: none;
        transform: none;
    }
}
.empty-state .botoes-vazio { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px; }
.spinner { border: 4px solid var(--ph-a); border-top-color: var(--ink); }

/* ===== Mapa: nunca por cima do cabeçalho; não prende a rolagem no celular ===== */
.map-container {
    position: relative; z-index: 0; isolation: isolate; /* panes/controles do Leaflet ficam aqui dentro */
    height: clamp(280px, 50vh, 420px); border: var(--border); border-radius: 0; box-shadow: 6px 6px 0 var(--ink);
}
@media (min-width: 1024px) { .map-container { height: 500px; } }
