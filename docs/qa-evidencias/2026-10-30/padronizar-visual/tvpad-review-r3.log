    --color-yellow: #fbbf24;
    --color-yellow-dark: #f59e0b;
    --color-yellow-light: #fcd34d;
    --color-green: #2dd4bf;
    --font-primary: var(--font-inter), -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-display: var(--font-bebas), 'Impact', sans-serif;
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;
    --radius-xl: 24px;
    --radius-full: 50%;
    --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.5);
    --shadow-glow-red: 0 0 20px var(--color-red-glow);
    --transition-fast: 0.15s ease;
    --transition-normal: 0.3s ease;
    --transition-slow: 0.5s ease;
    --z-header: 1000;
    --z-modal: 2000;
    --z-toast: 3000;
    --font-primary: var(--font-inter), -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-display: var(--font-bebas), 'Impact', sans-serif;
    min-height: 100vh;
    background: var(--color-black);
    color: var(--color-white);
    font-family: var(--font-primary);
    line-height: 1.6;
    padding-top: 1px;
}
.admin-tema h1, .admin-tema h2, .admin-tema h3, .admin-tema h4 {
    font-family: var(--font-display);
