import { describe, it, expect, vi } from 'vitest';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';

let caminho = '/';
delete process.env.DATABASE_URL;
vi.mock('next/navigation', () => ({ usePathname: () => caminho }));
vi.mock('@/lib/db', () => ({ default: { query: vi.fn(() => { throw new Error('não deveria consultar o banco'); }) } }));

const { default: HomePage } = await import('@/app/page');
const { default: Header } = await import('@/components/Header');
const { NAV_ITENS } = await import('@/lib/navegacao');

/** Trecho da barra do topo: da placa do logo até o botão "Enviar denúncia". */
function barra(html) {
    const ini = html.lastIndexOf('<div', html.indexOf('aria-label="TV Complexo, início"'));
    const fim = html.indexOf('Enviar denúncia</a>', ini) + 'Enviar denúncia</a>'.length;
    expect(ini).toBeGreaterThanOrEqual(0);
    expect(fim).toBeGreaterThan(ini + 'Enviar denúncia</a>'.length);
    return html.slice(ini, fim);
}

/** Links da barra, em ordem: href, texto e classes (sem o destaque da página atual). */
function composicao(trecho) {
    return [...trecho.matchAll(/<a([^>]*)>(.*?)<\/a>/g)].map(([, attrs, texto]) => ({
        href: attrs.match(/href="([^"]*)"/)[1],
        classe: attrs.match(/class="([^"]*)"/)?.[1] ?? '',
        atual: attrs.includes('aria-current="page"'),
        texto: texto.replace(/<[^>]+>/g, ''),
    }));
}

const esperado = [
    { href: '/', texto: '' }, // placa do logo
    ...NAV_ITENS.filter(i => !i.cta).map(i => ({ href: i.href, texto: i.label })),
    { href: '/denuncias/enviar', texto: 'Enviar denúncia' },
];

describe('barra do topo igual na Início e nas páginas internas', () => {
    it('Início e página interna têm a mesma composição completa, incluindo "Enviar denúncia" destacado', async () => {
        caminho = '/';
        const home = barra(renderToStaticMarkup(await HomePage({ searchParams: Promise.resolve({}) })));
        caminho = '/videos';
        const interna = barra(renderToStaticMarkup(createElement(Header)));

        const semAtual = t => t.replace(/ aria-current="page"/g, '');
        expect(semAtual(home)).toBe(semAtual(interna));

        for (const trecho of [home, interna]) {
            const links = composicao(trecho);
            expect(links.map(({ href, texto }) => ({ href, texto }))).toEqual(esperado);
            const cta = links.at(-1);
            expect(cta.classe).toContain('site-header-cta');
            expect(cta.classe).toMatch(/(^|_)btn(_|$)/); // botão cheio (s.btn), não link de texto
        }
    });

    it('cada uma destaca só a própria página', async () => {
        const atuais = trecho => composicao(trecho).filter(l => l.atual).map(l => l.href);
        caminho = '/';
        expect(atuais(barra(renderToStaticMarkup(await HomePage({ searchParams: Promise.resolve({}) }))))).toEqual(['/']);
        caminho = '/denuncias/enviar';
        expect(atuais(barra(renderToStaticMarkup(createElement(Header))))).toEqual(['/denuncias/enviar']);
    });
});
import { describe, it, expect, vi, beforeAll } from 'vitest';
import { renderToStaticMarkup } from 'react-dom/server';

// Sem banco: a Início não pode consultar nada nem mostrar texto de exemplo.
delete process.env.DATABASE_URL;
vi.mock('next/navigation', () => ({ usePathname: () => '/' }));
vi.mock('@/lib/db', () => ({ default: { query: vi.fn(() => { throw new Error('não deveria consultar o banco'); }) } }));

const { default: HomePage } = await import('@/app/page');
const { default: db } = await import('@/lib/db');

let html = '';
beforeAll(async () => {
    html = renderToStaticMarkup(await HomePage({ searchParams: Promise.resolve({}) }));
});

describe('Início sem dados (sem DATABASE_URL)', () => {
    it('renderiza o topo sem consultar o banco', () => {
        expect(html).toContain('topo-titulo');
        expect(db.query).not.toHaveBeenCalled();
    });

    it.each([
        /exemplo/i,
        /Player ainda não configurado/i,
        /em breve/i,
        /Demonstração — vídeos/i,
        /Vídeo do canal \d/i,
    ])('não mostra %s', (padrao) => {
        expect(html).not.toMatch(padrao);
    });

    it('esconde as seções sem conteúdo (vídeos, notícias, grade)', () => {
        expect(html).not.toContain('id="videos-titulo"');
        expect(html).not.toContain('id="noticias-titulo"');
        expect(html).not.toContain('id="grade"');
        expect(html).not.toContain('href="#grade"');
    });

    it('não tem link para o painel admin no público', () => {
        expect(html).not.toContain('href="/admin"');
    });
});
import { describe, it, expect, vi, beforeEach } from 'vitest';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';

let caminho = '/';
vi.mock('next/navigation', () => ({ usePathname: () => caminho }));

const { default: BottomNav } = await import('@/components/BottomNav');
const { default: NavPrincipal } = await import('@/components/NavPrincipal');
const { NAV_ITENS, itemAtivo } = await import('@/lib/navegacao');

/** hrefs dos links marcados com aria-current="page" no HTML. */
function atuais(html) {
    return [...html.matchAll(/<a[^>]*>/g)]
        .map(m => m[0])
        .filter(tag => tag.includes('aria-current="page"'))
        .map(tag => tag.match(/href="([^"]*)"/)[1]);
}

describe('navegação única (barra de baixo + cabeçalho)', () => {
    beforeEach(() => { caminho = '/'; });

    it.each([
        ['/', '/'],
        ['/videos', '/videos'],
        ['/videos/abc-123', '/videos'],
        ['/denuncias', '/denuncias'],
        ['/denuncias/enviar', '/denuncias/enviar'],
        ['/noticias', '/noticias'],
        ['/noticias/42', '/noticias'],
        ['/sobre', '/sobre'],
    ])('em %s só o botão %s fica com aria-current="page"', (path, esperado) => {
        caminho = path;
        expect(atuais(renderToStaticMarkup(createElement(BottomNav)))).toEqual([esperado]);
    });

    it('barra de baixo aparece também na Início, com todos os itens', () => {
        caminho = '/';
        const html = renderToStaticMarkup(createElement(BottomNav));
        for (const item of NAV_ITENS) expect(html).toContain(`href="${item.href}"`);
    });

    it('mapa (/denuncias) e enviar denúncia (/denuncias/enviar) são botões distintos', () => {
        const mapa = NAV_ITENS.find(i => i.href === '/denuncias');
        const enviar = NAV_ITENS.find(i => i.href === '/denuncias/enviar');
        expect(mapa).toBeTruthy();
        expect(enviar).toBeTruthy();
        expect(mapa.label).not.toBe(enviar.label);
    });

    it('página fora do menu (privacidade) não acende nenhum botão; admin não mostra a barra', () => {
        caminho = '/privacidade';
        expect(atuais(renderToStaticMarkup(createElement(BottomNav)))).toEqual([]);
        caminho = '/admin';
        expect(renderToStaticMarkup(createElement(BottomNav))).toBe('');
    });

    it('cabeçalho usa a mesma lista e o mesmo destaque', () => {
        caminho = '/videos/xyz';
        const html = renderToStaticMarkup(createElement(NavPrincipal));
        expect(atuais(html)).toEqual(['/videos']);
        expect(html).toContain('href="/denuncias"');
    });

    it('itemAtivo escolhe o item mais específico', () => {
        expect(itemAtivo('/denuncias/enviar')).toBe('/denuncias/enviar');
        expect(itemAtivo('/denuncias/123')).toBe('/denuncias');
        expect(itemAtivo('/videosx')).toBeNull();
        expect(itemAtivo(null)).toBeNull();
    });
});
import { describe, it, expect } from 'vitest';
import nextConfig from '../next.config.mjs';

describe('/mapa', () => {
    it('redireciona para /denuncias (permanente)', async () => {
        const regras = await nextConfig.redirects();
        const mapa = regras.filter(r => r.source === '/mapa');
        expect(mapa).toEqual([{ source: '/mapa', destination: '/denuncias', permanent: true }]);
    });
});
