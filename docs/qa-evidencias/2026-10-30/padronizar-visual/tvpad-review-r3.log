    margin-top: 0.5rem;
}
.admin-tema .moderation-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
}
.admin-tema .btn:focus-visible,
.admin-tema .card a:focus-visible {
    outline: 3px solid var(--color-yellow);
