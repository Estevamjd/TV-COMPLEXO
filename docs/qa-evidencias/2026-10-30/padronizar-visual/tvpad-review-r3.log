}
.mapa-trava:focus-visible { outline: 4px solid var(--yellow); box-shadow: 0 0 0 8px var(--ink); }
.mapa-dica { margin-top: 10px; font: 700 14px/1.4 var(--f-mono); }
.leaflet-bar a { border-radius: 0 !important; color: var(--ink) !important; }
